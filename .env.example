# Configuration Firebase (à renseigner dans .env.local en local et dans GitHub Secrets pour GitHub Pages)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
# Utiliser "(default)" pour une base standard, ou l'ID de l'instance Firestore provisionnée (ex: ai-studio-...)
VITE_FIREBASE_DATABASE_ID="ai-studio-fc7d5e1a-ce3e-4c8e-84ec-d119cb5294b3"

# Optionnel : chemin de base pour GitHub Pages (ex: /arena-group-crm/ ou ./)
VITE_BASE_PATH="./"
